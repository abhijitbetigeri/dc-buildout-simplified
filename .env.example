# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env

# --- ZooWork (Best Use of ZooWork prize) ---
# VERIFIED against the shipped SDK (@zoowork-ai/sdk 0.10.2, dist/).
# Exactly ONE variable is required:
ZOOWORK_API_KEY=

# Do NOT set these:
#   ZOOWORK_BASE_URL     leave UNSET. The default already includes the /service/v1
#                        prefix; setting it wrong 404s every call.
#   ZOOWORK_ORG_ID       does not exist. The gateway derives the tenant from the key.
#   ZOOWORK_AGENT_ID     not an SDK input. Agent IDs come back from createAgent()
#                        at runtime and we persist them ourselves.
#   ZOOWORK_WEBHOOK_SECRET   only for verifying inbound signed webhooks. We receive none.

# --- Moss (on-device semantic search) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Hackathon code: GALLERYHACKS

# --- Tavily (web research) ---
TAVILY_API_KEY=

# --- BAND (multi-agent rooms) ---
BAND_API_KEY=

# --- Entire (git network / session provenance) ---
# NO KEY NEEDED — Entire is free. Just install the CLI:
#   curl -fsSL https://entire.io/install.sh | bash
# Its primitive is a "trail" (entire trail resume [trail-id]); trails have shareable URLs.
