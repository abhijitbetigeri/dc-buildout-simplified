# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env
#
# STATUS: variable names below are BEST-GUESS until each track confirms them.
# The verified names land in status/recon.md, status/moss.md and status/agents.md
# as those agents finish. Check there before debugging an auth failure.

# --- ZooWork (Best Use of ZooWork prize — highest priority) ---
ZOOWORK_API_KEY=

# --- Moss (on-device semantic search) ---
# Docs showed MossClient(PROJECT_ID, PROJECT_KEY)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Hackathon code: GALLERYHACKS

# --- Tavily (web research) ---
TAVILY_API_KEY=

# --- BAND (multi-agent rooms) ---
BAND_API_KEY=

# --- Entire (git network / session provenance) ---
# The CLI may authenticate via `entire login` rather than an env var.
# Check status/recon.md before setting this.
ENTIRE_TOKEN=
