 ---\n# Docs showed MossClient(PROJECT_ID, PROJECT_KEY)\nMOSS_PROJECT_ID=\nMOSS_PROJECT_KEY=\n# Hackathon code: GALLERYHACKS\n\n# --- Tavily (web research) ---\nTAVILY_API_KEY=\n\n# --- BAND (multi-agent rooms) ---\nBAND_API_KEY=\n\n# --- Entire (git network / session provenance) ---\n# The CLI may authenticate via `entire login` rather than an env var.\n# Check status/recon.md before setting this.\nENTIRE_TOKEN=\n","userModified":false},"sourceToolAssistantUUID":"a9883c10-6bc8-4433-8715-e940474ab102","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/abhijitbetigeri/projects/line-down-desk","sessionId":"79c3b8a7-06a2-4fb1-8964-a4968e4c0492","version":"2.1.278","gitBranch":"HEAD"}
